        "streaming": false
      },
      "turns": [
        {
          "type": "tool_calls",
          "calls": [
            {
              "toolCallId": "demo-call-plan",
              "toolName": "declare_analysis_plan",
              "arguments": {
                "goal": "Summarize capture health",
                "steps": [
                  {
                    "tool": "get_capture_overview",
                    "purpose": "Read bounded capture-wide health indicators"
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "tool_calls",
          "calls": [
            {
              "toolCallId": "demo-call-overview",
              "toolName": "get_capture_overview",
              "arguments": { "scope": "complete_file" }
            }
          ]
        },
        {
          "type": "final",
          "expect": { "toolCallId": "demo-call-overview" },
          "report": {
            "summary": "Offline demo: the capture overview was read locally and no data left the device.",
            "completeness": "Partial",
            "findings": [
              {
                "id": "demo-finding-overview",
