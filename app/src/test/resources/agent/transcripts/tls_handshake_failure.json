                "frameNumber": 4,
                "observation": "Frame 4 supports TlsHandshakeFailure.",
                "sourceToolCallId": "call-evidence"
              },
              {
                "type": "Frame",
                "frameNumber": 6,
                "observation": "Frame 6 supports TlsHandshakeFailure.",
                "sourceToolCallId": "call-evidence"
              }
            ],
            "alternatives": [],
            "recommendations": [
              "Review the cited frames and retain the stated capture boundary."
            ]
          }
        ],
        "limitations": [
          "the alert description is visible",
          "why the server rejected the handshake is not visible"
        ],
        "recommendedNextSteps": [
